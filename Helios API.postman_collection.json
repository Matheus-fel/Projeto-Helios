  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Converte a resposta recebida em JSON\r\nvar response = pm.response.json();\r\n\r\n// Captura o token (funciona se vier em response.data.token ou response.token)\r\nvar token = (response.data && response.data.token) || response.token;\r\n\r\nif (token) {\r\n    pm.environment.set(\"token\", token);\r\n    console.log(\"✅ Token JWT capturado com sucesso e salvo no ambiente!\");\r\n} else {\r\n    console.log(\"❌ Token não encontrado na resposta.\");\r\n}\r\n\r\n// Validação automática do código de status\r\npm.test(\"Status code é 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"admin@helios.com\",\r\n  \"senha\": \"admin123\" \r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
